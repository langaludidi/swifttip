VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Test-only — the app itself never reads this. Required to run
# `npm run test:regression` (tests/regression/), which creates and tears down
# throwaway accounts directly. Get it from Supabase dashboard > Settings > API.
# Never commit a real value here.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
